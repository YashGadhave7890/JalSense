# =============================================================================
# JalSense Environment Configuration (Safe Template)
# =============================================================================

# Docker & Registry Configuration
DOCKERHUB_USERNAME=DOCKERHUB_USERNAME
IMAGE_TAG=1.0.0

# Service Ports & Networking
API_PORT=8000
API_HOST=0.0.0.0
FRONTEND_PORT=3000
STREAMLIT_PORT=8501
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000

# Open-Meteo Weather API (Open Source, No Key Required)
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_ARCHIVE_URL=https://archive-api.open-meteo.com/v1/archive

# National Benchmark (Jal Jeevan Mission Standard)
JJM_BENCHMARK_LPCD=55.0

# Logging & Telemetry
LOG_LEVEL=INFO
DEBUG=False

# JalSense AI Conversational Assistant (Optional Cloud LLM Integration)
# Supported providers: groq, openai, openrouter, gemini, or leave blank for local deterministic fallback
LLM_PROVIDER=groq
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL=openai/gpt-oss-120b
LLM_BASE_URL=https://api.groq.com/openai/v1
